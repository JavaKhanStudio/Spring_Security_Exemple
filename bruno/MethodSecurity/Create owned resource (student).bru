meta {
  name: Create owned resource (student)
  type: http
  seq: 10
}

post {
  url: {{connectionPath}}/examples/owned-resource
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "owner": "student1",
    "content": "donnee confidentielle de student1"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  // Ressource appartenant a student1 : servira a montrer le refus @PostAuthorize cote admin.
  bru.setVar("otherResourceId", res.body.id);
}
