meta {
  name: Connection as User
  type: http
  seq: 4
}

post {
  url: {{connectionPath}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "username": "student1",
    "password": "password"
  }
}

script:post-response {
  // Capture the JWT returned by /api/login as a runtime variable (like the Postman test script).
  // setVar keeps it runtime-only so the token is never written to disk / committed to git.
  bru.setVar("userToken", res.body.token);
}
